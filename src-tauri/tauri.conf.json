{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rize Local",
  "version": "1.2.0",
  "identifier": "io.github.perfectfighter.rsrize",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "shortDescription": "The existing Rize Local app, ported to Rust",
    "category": "Productivity",
    "resources": ["../THIRD-PARTY-NOTICES.md", "../docs/licenses/*"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper", "silent": true},
      "nsis": {"installMode": "currentUser", "displayLanguageSelector": false}
    }
  }
}
